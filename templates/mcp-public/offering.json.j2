{#- Public, keyless MCP servers. One template, one param file per server.

    `auth_mode: none` is the whole reason these can ship before OAuth brokering
    (unitysvc-labs/unitysvc-services-mcp#1): nothing has to be injected, so a
    customer enrolls and the tools work.

    `details.tools` is the pinned manifest, captured from a live `tools/list`
    (tools/refresh_manifests.py). It lives here rather than on the channel
    because it is catalog-facing and secret-free — the gateway serves
    `tools/list` from it without reading upstream_access_config, and it still
    answers when the upstream is down. -#}
{
  "capabilities": [
    "mcp"
  ],
  "description": {{ description | tojson }},
  "details": {
    "tools": {{ tools | tojson }}
  },
  "name": "{{ name.split('/')[-1] }}",
  "payout_price": {
    "description": "Public upstream — no seller payout",
    "percentage": "0.00",
    "type": "revenue_share"
  },
  "service_type": "mcp",
  "status": "ready",
  "tags": {{ (tags | default(['mcp'])) | tojson }},
  "time_created": "2026-08-15T00:00:00Z",
  "upstream_access_config": {
    "{{ namespace }}": {
      "access_method": "mcp",
      "auth_mode": "none",
      "base_url": "{{ upstream_url }}",
      "timeout_ms": {{ timeout_ms | default(30000) }},
      "transport": "streamable_http"
    }
  }
}
